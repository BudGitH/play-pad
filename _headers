# Cloudflare Pages — HTTP headers for PlayPad
# This file must sit at the ROOT of the deployed site (the repo root).
# Docs: https://developers.cloudflare.com/pages/configuration/headers/

/*
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  Referrer-Policy: no-referrer
  Cross-Origin-Opener-Policy: same-origin
  Permissions-Policy: accelerometer=(), camera=(), display-capture=(), geolocation=(), gyroscope=(), microphone=(), payment=(), usb=()
  Content-Security-Policy: default-src 'self'; base-uri 'none'; object-src 'none'; frame-ancestors 'none'; form-action 'none'; img-src 'self' data: blob:; style-src 'self' 'unsafe-inline'; script-src 'self' 'unsafe-inline'; font-src 'self'; connect-src 'self' blob:; manifest-src 'self'

# HTML — always revalidate so updates appear immediately (filenames aren't hashed)
/
  Cache-Control: public, max-age=0, must-revalidate
/index.html
  Cache-Control: public, max-age=0, must-revalidate
/404.html
  Cache-Control: public, max-age=0, must-revalidate
/games/colour-rush/
  Cache-Control: public, max-age=0, must-revalidate
/games/colour-rush/index.html
  Cache-Control: public, max-age=0, must-revalidate
/games/snap/
  Cache-Control: public, max-age=0, must-revalidate
/games/snap/index.html
  Cache-Control: public, max-age=0, must-revalidate
/games/claw-catch/
  Cache-Control: public, max-age=0, must-revalidate
/games/claw-catch/index.html
  Cache-Control: public, max-age=0, must-revalidate
/games/super-decoder/
  Cache-Control: public, max-age=0, must-revalidate
/games/super-decoder/index.html
  Cache-Control: public, max-age=0, must-revalidate
/games/neon-rush/
  Cache-Control: public, max-age=0, must-revalidate
/games/neon-rush/index.html
  Cache-Control: public, max-age=0, must-revalidate

# Vendored Three.js (version-pinned r147) + GLTFLoader + CC0 assets — safe to cache long
/games/neon-rush/three.min.js
  Cache-Control: public, max-age=604800
/games/neon-rush/GLTFLoader.js
  Cache-Control: public, max-age=604800
/games/neon-rush/assets/*
  Cache-Control: public, max-age=604800

# Shared CSS / JS and the registry — always revalidate. Filenames are NOT hashed, and these ship
# in lock-step with index.html and every game page (new tokens, new registry fields). A plain
# max-age would let a returning visitor get the NEW html with the OLD cached CSS/JS until it
# expires (PLAY-006 AR-01). Revalidation is cheap: the ETag turns an unchanged file into a 304.
/styles/*
  Cache-Control: public, max-age=0, must-revalidate
/scripts/*
  Cache-Control: public, max-age=0, must-revalidate
/games.js
  Cache-Control: public, max-age=0, must-revalidate

# Brand icons — rarely change, and a stale icon is cosmetic only, so a day is fine.
# max-age here is NOT revalidated: the browser will not even ask the server until it expires.
/icons/*
  Cache-Control: public, max-age=86400

# Web app manifest — correct type + cache
/manifest.webmanifest
  Content-Type: application/manifest+json; charset=utf-8
  Cache-Control: public, max-age=86400
