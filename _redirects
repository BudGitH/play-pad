# Cloudflare Pages redirects for PlayPad.
# The whole repo root is deployed, so dev-only files would otherwise be served.
# These rules send them to the hub instead. Redirects take precedence over
# static files on Cloudflare Pages.
# Docs: https://developers.cloudflare.com/pages/configuration/redirects/

/docs              /  302
/docs/*            /  302
/package.json      /  302
/package-lock.json /  302
/CLAUDE.md         /  302
/features          /  302
/features/*        /  302
/tools             /  302
/tools/*           /  302
/.github           /  302
/.github/*         /  302
/.githooks         /  302
/.githooks/*       /  302
/.claude           /  302
/.claude/*         /  302
/.gitignore        /  302
/.gitattributes    /  302
/.prettierignore   /  302
/.prettierrc.json  /  302
/.env.example      /  302
/eslint.config.mjs /  302
/games/neon-rush/CLAUDE.md /  302
/README.md         /  302
/CONTRIBUTING.md   /  302
/CODE_OF_CONDUCT.md /  302
/SECURITY.md       /  302
