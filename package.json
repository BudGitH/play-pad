{
  "name": "playpad",
  "private": true,
  "description": "Dev-only tooling for PlayPad. The site itself has no build step and no runtime dependencies.",
  "license": "MIT",
  "scripts": {
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "npm run lint && npm run ratchet && npm run format:check",
    "secrets": "node tools/secret-scan.mjs",
    "smoke": "playwright test --grep-invert @slow",
    "perf:kq": "playwright test tests/kampung-quest-ac.spec.mjs --grep @slow",
    "test:kq": "node --test \"tests/kampung-quest/*.test.mjs\"",
    "ratchet": "node tools/lint-ratchet.mjs"
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "@playwright/test": "1.65.0",
    "eslint": "9.39.5",
    "eslint-plugin-html": "8.2.1",
    "globals": "15.14.0",
    "prettier": "3.4.2"
  }
}
